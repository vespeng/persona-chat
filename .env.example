# 环境变量示例
#
# 本项目为 Cloudflare Worker，环境变量优先级如下：
#   线上：Cloudflare 控制台 / secret > 代码默认值（src/index.ts 中的 DEFAULT_*）
#   本地：.dev.vars > 代码默认值
#
# 本文件仅作为变量清单，不会被 wrangler 自动读取。
#
# 本地开发时如需覆盖默认值，将本文件复制为 .dev.vars（已被 .gitignore 忽略，不会提交）：
#   cp .env.example .dev.vars
#
# 线上部署如需配置变量，可在 Cloudflare 控制台（Worker -> 设置 -> 变量）中设置，
# 或使用 `wrangler secret put <KEY>` 配置同名密钥（密钥优先级高于明文变量）。

# Workers AI 模型 ID（核心变量，决定聊天所使用的模型）
# 可用模型列表: https://developers.cloudflare.com/workers-ai/models/
MODEL_ID=@cf/meta/llama-3.1-8b-instruct-fp8

# 前端页面标题（index.html 的 <title>，由 Worker 动态注入）
APP_TITLE=AI Chat
